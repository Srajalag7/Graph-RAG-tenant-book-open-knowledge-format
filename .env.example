# ── Gemini API Configuration ──
# Copy this file to .env and fill in your values

# Required: Your Gemini API key from Google AI Studio
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use (must be from the allowed list in references/README.md)
MODEL=gemini-3.5-flash-lite

# Gemini OpenAI-compatible endpoint
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Corpus directory
CORPUS_DIR=corpus

# Service port
PORT=8000

# Bounded iterative OKF navigation (limits return errors, never corpus refusals)
MAX_TRAVERSAL_ROUNDS=8
QUERY_TIMEOUT=180

# ── Judge Configuration (for grading) ──
JUDGE_MODEL=gemini-3.5-flash-lite
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
JUDGE_API_KEY=your-gemini-api-key-here

# Minimum pause after each Gemini attempt (seconds; 0 disables pacing)
GEMINI_CALL_DELAY_SECONDS=0
